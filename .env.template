# ============================================================
# Sheress - Environment Configuration
# Copy this file to .env and fill in the values
# ============================================================

# Supabase Project Configuration
# Get these from: Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (FOR SERVER-SIDE USE ONLY - DO NOT EXPOSE)
# Used for admin operations in backend/edge functions
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Database Connection (Direct PostgreSQL, for migrations)
# Get from: Project Settings > Database > Connection string
SUPABASE_DATABASE_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# App Configuration
APP_NAME=Sheress
APP_VERSION=1.0.0
APP_ENVIRONMENT=development

# Offline Sync Configuration
SYNC_INTERVAL_SECONDS=30
SYNC_BATCH_SIZE=50

# QRIS Image Caching
QRIS_CACHE_DAYS=30
